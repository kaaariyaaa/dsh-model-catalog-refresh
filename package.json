{
  "name": "dsh-model-catalog-refresh",
  "version": "0.1.0",
  "description": "Refresh DeepSeek Harness ACP API-provider model catalogs on a 4-hour schedule and from the command line",
  "license": "MIT",
  "author": "kaaariyaaa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaaariyaaa/dsh-model-catalog-refresh.git"
  },
  "homepage": "https://github.com/kaaariyaaa/dsh-model-catalog-refresh#readme",
  "bugs": {
    "url": "https://github.com/kaaariyaaa/dsh-model-catalog-refresh/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./acp": {
      "types": "./lib/acp.d.ts",
      "default": "./lib/acp.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "acp",
    "llm",
    "model-catalog"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-0 <0.3.0",
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "test:unit": "node --test test/*.test.js",
    "prepublishOnly": "npm run build && npm test",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-cmdline": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-config-editor": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-0 <0.3.0"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-cmdline": "0.2.2-rc.5",
    "@deepseek-ai/dsh-config-editor": "0.2.2-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  }
}
